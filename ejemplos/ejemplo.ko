// Programa de ejemplo en el lenguaje EYKOL

ent n = 5;
ent factorial = 1;
repetir (ent i = 1; i <= n; i = i + 1) {
    factorial = factorial * i;
}
impt("El factorial de " + n + " es " + factorial);

/* Condicionales */
deci nota = 8.5;
si (nota >= 9) {
    impt("Excelente");
} osi si (nota >= 7) {
    impt("Aprobado");
} osi {
    impt("Reprobado");
}

// Ciclo durante
ent contador = 3;
durante (contador > 0) {
    impt(contador);
    contador = contador - 1;
}

boli listo = vrd && !fals;
impt(listo);
